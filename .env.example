# Возможные значения: ollama | openai | mock
LLM_PROVIDER=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# OpenAI (если LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Telegram ----
# TELEGRAM_TOKEN=123456:ABC-DEF...

SAFETY_ENABLED=true

FAISS_INDEX_PATH=vector_index/faiss_index.bin
FAISS_CHUNKS_PATH=vector_index/chunks.pkl
KNOWLEDGE_BASE_PATH=knowledge_base
QUERY_LOG_PATH=logs/queries.jsonl
UPDATE_LOG_PATH=logs/update.log
